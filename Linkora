<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Linkora | تصميم روابط حساباتك</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, sans-serif;
      background: #080808;
      color: #ffffff;
      line-height: 1.8;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .container {
      width: 92%;
      max-width: 1150px;
      margin: auto;
    }

    /* Header */
    header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: #080808;
      border-bottom: 1px solid #2e2416;
    }

    .nav {
      min-height: 75px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .logo {
      font-size: 25px;
      font-weight: bold;
      letter-spacing: 4px;
      color: #e8bd68;
    }

    .nav-links {
      display: flex;
      gap: 28px;
      color: #cfcfcf;
      font-size: 14px;
    }

    .nav-links a:hover {
      color: #e8bd68;
    }

    .nav-button {
      border: 1px solid #b98d3f;
      border-radius: 25px;
      padding: 8px 18px;
      color: #e8bd68;
    }

    /* Hero */
    .hero {
      min-height: 650px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 60px;
      padding: 80px 0;
    }

    .hero-label {
      color: #d2a852;
      font-size: 15px;
      margin-bottom: 15px;
    }

    .hero h1 {
      font-size: clamp(42px, 6vw, 72px);
      line-height: 1.2;
      margin-bottom: 22px;
    }

    .gold {
      color: #e8bd68;
    }

    .hero p {
      color: #aaaaaa;
      font-size: 17px;
      max-width: 500px;
      margin-bottom: 25px;
    }

    .price {
      color: #e8bd68;
      font-size: 34px;
      font-weight: bold;
      margin-bottom: 25px;
    }

    .price span {
      color: #888888;
      font-size: 14px;
      font-weight: normal;
    }

    .main-button {
      display: inline-block;
      padding: 14px 28px;
      border-radius: 30px;
      background: #e8bd68;
      color: #111111;
      font-weight: bold;
    }

    .main-button:hover {
      background: #f1d38e;
    }

    /* Product Preview */
    .preview {
      display: flex;
      justify-content: center;
    }

    .phone {
      width: 280px;
      padding: 20px;
      border: 2px solid #8f6a32;
      border-radius: 35px;
      background: #101010;
    }

    .phone-avatar {
      width: 80px;
      height: 80px;
      margin: 10px auto;
      border-radius: 50%;
      border: 2px solid #d5ab58;
      background: #1c1c1c;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      color: #e8bd68;
    }

    .phone h3 {
      text-align: center;
      margin-top: 10px;
    }

    .phone p {
      text-align: center;
      color: #777777;
      font-size: 12px;
      margin-bottom: 20px;
    }

    .phone-link {
      display: block;
      padding: 10px;
      margin: 9px 0;
      border: 1px solid #3f3f3f;
      border-radius: 10px;
      text-align: center;
      color: #dddddd;
      font-size: 13px;
    }

    /* Sections */
    .section {
      padding: 80px 0;
      border-top: 1px solid #1e1e1e;
    }

    .section-title {
      text-align: center;
      margin-bottom: 40px;
    }

    .section-title small {
      color: #d2a852;
    }

    .section-title h2 {
      font-size: 32px;
      margin: 8px 0;
    }

    .section-title p {
      color: #888888;
    }

    /* Features */
    .features {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .feature {
      background: #101010;
      border: 1px solid #352914;
      border-radius: 18px;
      padding: 28px 18px;
      text-align: center;
    }

    .feature-icon {
      font-size: 30px;
      color: #e8bd68;
      margin-bottom: 12px;
    }

    .feature h3 {
      color: #e8bd68;
      font-size: 17px;
      margin-bottom: 10px;
    }

    .feature p {
      color: #999999;
      font-size: 13px;
    }

    /* Samples */
    .samples {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .sample {
      background: #101010;
      border: 1px solid #3c2d18;
      border-radius: 18px;
      padding: 20px;
      text-align: center;
    }

    .sample-avatar {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      margin: auto auto 10px;
      border: 1px solid #c59a4c;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #e8bd68;
      font-weight: bold;
    }

    .sample p {
      color: #777777;
      font-size: 11px;
      margin-bottom: 15px;
    }

    .sample-link {
      display: block;
      border: 1px solid #383838;
      border-radius: 8px;
      padding: 7px;
      margin: 7px 0;
      font-size: 11px;
    }

    /* Order */
    .order {
      text-align: center;
      padding: 55px 20px;
      border: 1px solid #5a431e;
      border-radius: 22px;
      background: #0e0e0e;
    }

    .order h2 {
      font-size: 32px;
      margin-bottom: 12px;
    }

    .order p {
      color: #999999;
      margin-bottom: 25px;
    }

    /* Footer */
    footer {
      border-top: 1px solid #2a2115;
      padding: 30px 0;
      text-align: center;
      color: #777777;
      font-size: 13px;
    }

    .footer-logo {
      color: #e8bd68;
      font-size: 22px;
      font-weight: bold;
      letter-spacing: 4px;
      margin-bottom: 8px;
    }

    /* Mobile */
    @media (max-width: 800px) {
      .nav-links {
        display: none;
      }

      .hero {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 40px;
      }

      .hero p {
        margin-left: auto;
        margin-right: auto;
      }

      .features {
        grid-template-columns: 1fr 1fr;
      }

      .samples {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 500px) {
      .features {
        grid-template-columns: 1fr;
      }

      .samples {
        grid-template-columns: 1fr 1fr;
      }

      .hero {
        padding: 55px 0;
      }

      .hero h1 {
        font-size: 42px;
      }
    }
  </style>
</head>

