
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Linkora | تصميم روابط حساباتك</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap');

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: 'Cairo', sans-serif;
  background:
    radial-gradient(circle at 80% 10%, #4b3515 0%, transparent 25%),
    radial-gradient(circle at 10% 80%, #30200d 0%, transparent 25%),
    #080808;
  color: white;
  line-height: 1.8;
}

a {
  text-decoration: none;
  color: inherit;
}

.container {
  width: min(1150px, 92%);
  margin: auto;
}

/* الشريط العلوي */
header {
  border-bottom: 1px solid #3b2b16;
  background: rgba(8, 8, 8, 0.9);
  position: sticky;
  top: 0;
  z-index: 10;
  backdrop-filter: blur(15px);
}

.navbar {
  min-height: 75px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.logo {
  font-size: 28px;
  font-weight: 800;
  letter-spacing: 4px;
  color: #f0c875;
}

.logo span {
  color: white;
}

nav {
  display: flex;
  gap: 28px;
  color: #ddd;
  font-size: 15px;
}

nav a:hover {
  color: #f0c875;
}

.order-button {
  border: 1px solid #c99d4c;
  border-radius: 30px;
  padding: 9px 20px;
  color: #f5d58d;
  transition: 0.3s;
}

.order-button:hover {
  background: #c99d4c;
  color: #111;
}

/* القسم الرئيسي */
.hero {
  min-height: 650px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 45px;
  padding: 70px 0;
}

.small-title {
  color: #d8ae5d;
  font-size: 18px;
  margin-bottom: 15px;
}

.hero h1 {
  font-size: clamp(38px, 5vw, 70px);
  line-height: 1.35;
  margin-bottom: 25px;
}

.gold {
  color: #eac36e;
}

.hero p {
  color: #c8c8c8;
  font-size: 18px;
  max-width: 520px;
  margin-bottom: 30px;
}

.main-button {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  background: linear-gradient(135deg, #ffe29a, #bd8733);
  color: #17110a;
  padding: 14px 28px;
  border-radius: 35px;
  font-weight: 800;
  box-shadow: 0 0 25px rgba(225, 170, 70, 0.25);
  transition: 0.3s;
}

.main-button:hover {
  transform: translateY(-4px);
  box-shadow: 0 0 35px rgba(225, 170, 70, 0.5);
}

.price {
  color: #aaa;
  margin-top: 12px;
  font-size: 14px;
}

/* صورة الهاتف */
.phone-area {
  display: flex;
  justify-content: center;
  align-items: center;
}

.phone {
  width: 270px;
  min-height: 510px;
  border: 3px solid #b98b3d;
  border-radius: 38px;
  padding: 30px 18px;
  background:
    radial-gradient(circle at 50% 15%, #253c43, transparent 28%),
    linear-gradient(160deg, #101010, #050505);
  box-shadow:
    0 0 25px rgba(220, 170, 70, 0.3),
    inset 0 0 25px rgba(255, 255, 255, 0.04);
  transform: rotate(5deg);
}

.phone-top {
  text-align: center;
  margin-bottom: 22px;
}

.phone-avatar {
  width: 70px;
  height: 70px;
  border-radius: 50%;
  margin: auto;
  display: grid;
  place-items: center;
  border: 2px solid #d5ad5e;
  font-size: 30px;
  background: #161616;
}

.phone h3 {
  margin-top: 10px;
  font-size: 18px;
}

.phone small {
  color: #aaa;
}

.phone-link {
  display: block;
  border: 1px solid #555;
  border-radius: 12px;
  padding: 8px;
  margin: 10px 0;
  text-align: center;
  font-size: 13px;
  transition: 0.3s;
}

.phone-link:hover {
  border-color: #e2b85e;
  box-shadow: 0 0 12px rgba(226, 184, 94, 0.35);
}

/* الأرقام */
.stats {
  display: flex;
  gap: 45px;
  margin-top: 35px;
}

.stat strong {
  display: block;
  color: #f0c875;
  font-size: 25px;
}

.stat span {
  color: #aaa;
  font-size: 13px;
}

/* الأقسام */
.section {
  padding: 75px 0;
}

.section-title {
  text-align: center;
  margin-bottom: 35px;
}

.section-title small {
  color: #d8ae5d;
}

.section-title h2 {
  font-size: 32px;
  margin-top: 5px;
}

.section-title p {
  color: #999;
}

/* المميزات */
.features {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.feature {
  border: 1px solid #4b371d;
  border-radius: 20px;
  padding: 28px 20px;
  text-align: center;
  background: linear-gradient(145deg, #121212, #0b0b0b);
  transition: 0.3s;
}

.feature:hover {
  transform: translateY(-6px);
  border-color: #d5a94e;
}

.feature-icon {
  font-size: 38px;
  color: #e8c36f;
  margin-bottom: 10px;
}

.feature h3 {
  color: #e8c36f;
  font-size: 18px;
  margin-bottom: 10px;
}

.feature p {
  color: #aaa;
  font-size: 14px;
}

/* النماذج */
.samples {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.sample {
  min-height: 300px;
  border: 1px solid #59401f;
  border-radius: 22px;
  padding: 20px;
  text-align: center;
  background: linear-gradient(160deg, #17120c, #080808);
  transition: 0.3s;
}

.sample:hover {
  transform: translateY(-7px);
  box-shadow: 0 0 25px rgba(220, 170, 70, 0.2);
}

.sample:nth-child(2) {
  background: linear-gradient(160deg, #24122d, #080808);
}

.sample:nth-child(3) {
  background: linear-gradient(160deg, #10283b, #080808);
}

.sample:nth-child(4) {
  background: linear-gradient(160deg, #321313, #080808);
}

.sample-avatar {
  width: 65px;
  height: 65px;
  margin: 5px auto 12px;
  border-radius: 50%;
  border: 2px solid #e2bc68;
  display: grid;
  place-items: center;
  font-size: 25px;
}

.sample h3 {
  font-size: 17px;
}

.sample p {
  color: #aaa;
  font-size: 12px;
  margin-bottom: 18px;
}

.sample-link {
  display: block;
  border: 1px solid #6b5129;
  border-radius: 9px;
  padding: 5px;
  margin: 7px 0;
  font-size: 12px;
}

/* دعوة الطلب */
.cta {
  border: 1px solid #745522;
  border-radius: 25px;
  padding: 45px 25px;
  text-align: center;
  background:
    radial-gradient(circle at 20% 50%, rgba(180, 125, 35, 0.18), transparent 30%),
    #0d0d0d;
}

.cta h2 {
  font-size: 32px;
  margin-bottom: 10px;
}

.cta p {
  color: #aaa;
  margin-bottom: 25px;
}

/* التذييل */
footer {
  border-top: 1px solid #332513;
  padding: 30px 0;
  margin-top: 60px;
}

.footer-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.footer-text {
  color: #999;
  font-size: 13px;
}

.footer-links {
  display: flex;
  gap: 15px;
  color: #dcb665;
}

/* الجوال */
@media (max-width: 800px) {
  nav {
    display: none;
  }

  .hero {
    grid-template-columns: 1fr;
    text-align: center;
    padding: 45px 0;
  }

  .hero p {
    margin-left: auto;
    margin-right: auto;
  }

  .stats {
    justify-content: center;
    gap: 25px;
  }

  .phone-area {
    margin-top: 20px;
  }

  .features {
    grid-template-columns: repeat(2, 1fr);
  }

  .samples {
    grid-template-columns: repeat(2, 1fr);
  }

  .footer-content {
    flex-direction: column;
    text-align: center;
  }
}

@media (max-width: 450px) {
  .logo {
    font-size: 22px;
  }

  .order-button {
    padding: 7px 13px;
    font-size: 12px;
  }

  .features,
  .samples {
    grid-template-columns: 1fr;
  }

  .hero h1 {
    font-size: 38px;
  }

  .phone {
    transform: none;
  }
}
</style>
</head>

